# Senha de quem pode atualizar dados e configurações (OBRIGATÓRIA para gravar). Use algo longo.
ADMIN_PASSWORD=troque-esta-senha-admin

# Senha para quem só visualiza (opcional). Se definida, o link inteiro pede senha (usuário: qualquer um).
# Deixe vazia para qualquer pessoa com o link ver o painel.
VIEW_PASSWORD=

# Use 1 quando houver proxy/HTTPS na frente (Caddy, Nginx, Railway, Render...).
TRUST_PROXY=1

# Na primeira execução o banco é preenchido com data/atendimentos.csv. Use 0 para começar vazio.
SEED_FROM_DATA=1

# Limite de cada envio, em MB.
MAX_UPLOAD_MB=50
